rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // PERFIL DO USUÁRIO: Apenas o próprio dono pode ler e escrever.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // PRODUTOS: Leitura pública para todos, escrita apenas para usuários logados.
    match /products/{productId} {
      allow read: if true; 
      allow write: if request.auth != null;
    }

    // REGRA PADRÃO: Bloqueia tudo que não foi definido acima.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
